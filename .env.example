# Copia este archivo como .env para desarrollo local.
# Coincide con compose.yaml; no es un secreto.
DATABASE_URL=postgres://semaforo:semaforo@127.0.0.1:5432/semaforo
# Auth.js (caso 1): secreto para firmar la sesión y URL pública
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# OAuth App de GitHub (opcional en local: sin ellas solo aparece "Entrar como demo")
GITHUB_ID=
GITHUB_SECRET=
# Token fine-grained de solo lectura para el caso 4
GITHUB_TOKEN=

# Alertas de incidentes a Discord (opcional): webhook https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URL=
# URL pública de la app, para el enlace en las alertas (opcional)
APP_URL=
# Webhooks de GitHub (opcional): genera el valor con `openssl rand -hex 32` y pégalo en
# GitHub > Settings > Webhooks (URL /api/github/webhook, content type application/json,
# eventos: workflow runs, releases, pull requests). Sin él, la ruta responde 503.
GITHUB_WEBHOOK_SECRET=
